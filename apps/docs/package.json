{
  "name": "@soroush.tech/docs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Documentation and demo site for the @soroush.tech design-system packages, served at docs.soroush.design.",
  "scripts": {
    "dev": "vite",
    "prebuild": "tsc -b",
    "build": "vite build && tsx scripts/emitLlms.ts",
    "preview": "vite preview",
    "preview:e2e": "serve build/client -l 9998",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@mdx-js/react": "^3.1.1",
    "@soroush.tech/design-system": "workspace:*",
    "@soroush.tech/docs-content": "workspace:*",
    "@soroush.tech/hooks": "workspace:*",
    "@soroush.tech/lab": "workspace:*",
    "@soroush.tech/markdown": "workspace:*",
    "@soroush.tech/story-demo": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "vike": "^0.4.260",
    "vike-react": "^0.6.26"
  },
  "devDependencies": {
    "@emotion/server": "^11.11.0",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.62.1",
    "@soroush.tech/eslint-config": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "oxlint": "^1.78.0",
    "serve": "^14.2.6",
    "tsx": "^4.20.6",
    "typescript": "~7.0.2",
    "vite": "~8.0.16",
    "vitest": "^4.1.10"
  }
}
