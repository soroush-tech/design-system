{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": [],
    "paths": {
      "@gild-ui/react": ["../dist/index.d.mts"],
      "@gild-ui/react/*": ["../dist/*.d.mts"],
      "@gild-ui/core/*": ["../../core/dist/*.d.mts"]
    }
  },
  "include": ["."],
  "exclude": ["init"]
}
