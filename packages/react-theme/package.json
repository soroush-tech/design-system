{
  "name": "@soroush.design/react-theme",
  "version": "0.1.0",
  "description": "The theme of the soroush.design React platform - ThemeProvider, the hooks that read the theme, the theme types, and the configured styled, css, keyframes and Global on the UmberStyle engine - for building your own components on the same tokens, with no component library.",
  "keywords": [
    "design-system",
    "react",
    "umberstyle",
    "theme",
    "tokens",
    "styled",
    "typescript"
  ],
  "author": "Masoud Soroush <masoud@soroush.tech>",
  "license": "MIT",
  "homepage": "https://docs.soroush.design/react/theme/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soroush-tech/design-system.git",
    "directory": "packages/react-theme"
  },
  "bugs": {
    "url": "https://github.com/soroush-tech/design-system/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/theme/index.ts",
    "./style": "./src/style/index.ts",
    "./engine": "./src/engine/index.ts"
  },
  "types": "./src/index.ts",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.mjs"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./theme": {
        "import": {
          "types": "./dist/theme.d.mts",
          "default": "./dist/theme.mjs"
        },
        "require": {
          "types": "./dist/theme.d.cts",
          "default": "./dist/theme.cjs"
        }
      },
      "./style": {
        "import": {
          "types": "./dist/style.d.mts",
          "default": "./dist/style.mjs"
        },
        "require": {
          "types": "./dist/style.d.cts",
          "default": "./dist/style.cjs"
        }
      },
      "./engine": {
        "import": {
          "types": "./dist/engine.d.mts",
          "default": "./dist/engine.mjs"
        },
        "require": {
          "types": "./dist/engine.d.cts",
          "default": "./dist/engine.cjs"
        }
      }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "typesVersions": {
      "*": {
        "*": [
          "./dist/*.d.cts"
        ]
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:types": "pnpm --filter @soroush.design/core build && pnpm build && tsc -p type-tests/augmentation/tsconfig.json && tsc -p type-tests/no-augmentation/tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@umber-style/cache": "^0.3.0",
    "@umber-style/react": "^0.3.0",
    "@umber-style/styled": "^0.3.0",
    "@soroush.design/core": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@soroush.tech/eslint-config": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.93.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  }
}
