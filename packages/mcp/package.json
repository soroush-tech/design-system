{
  "name": "@soroush.tech/mcp",
  "version": "0.1.0",
  "description": "MCP server for the @soroush.tech design system - serves the component inventory, every component README, and the theme token contract to AI coding tools.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "design-system",
    "ai",
    "claude",
    "documentation",
    "cloudflare-workers",
    "typescript"
  ],
  "author": "Masoud Soroush <masoud@soroush.tech>",
  "license": "MIT",
  "homepage": "https://docs.soroush.design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soroush-tech/design-system.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/soroush-tech/design-system/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "bin": {
    "soroush-mcp": "./dist/bin.mjs"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "publishConfig": {
    "access": "public",
    "bin": {
      "soroush-mcp": "./dist/bin.mjs"
    },
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.mjs"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts"
  },
  "scripts": {
    "gen": "tsx scripts/generate-content.ts",
    "build": "pnpm gen && tsdown",
    "build:worker": "pnpm gen && wrangler deploy --dry-run --outdir dist-worker",
    "lint": "oxlint --deny-warnings",
    "typecheck": "pnpm gen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "pnpm gen && wrangler dev",
    "deploy": "pnpm gen && wrangler deploy",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@soroush.tech/docs-content": "workspace:*",
    "@soroush.tech/eslint-config": "workspace:*",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "oxlint": "^1.78.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.20.6",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.42.2"
  }
}
