{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": false,
    "jsx": "react-jsx",
    "types": [],
    "paths": {
      "@soroush.design/core/*": ["../../core/dist/*.d.mts"],
      "@soroush.design/react-hooks": ["../../react-hooks/dist/index.d.mts"],
      "@soroush.design/react-hooks/*": ["../../react-hooks/dist/*.d.mts"],
      "@soroush.design/react": ["../../react/dist/index.d.mts"],
      "@soroush.design/react/*": ["../../react/dist/*.d.mts"],
      "@soroush.design/react-markdown": ["../../react-markdown/dist/index.d.mts"],
      "@soroush.design/react-markdown/*": ["../../react-markdown/dist/*.d.mts"]
    }
  }
}
