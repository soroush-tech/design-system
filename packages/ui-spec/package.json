{
  "name": "@soroush.tech/ui-spec",
  "version": "0.1.0",
  "description": "The generative-UI spec for the @soroush.tech design system: A2UI v1.0 catalogs, a behavior schema for page data, and validators that return findings as data.",
  "keywords": [
    "a2ui",
    "generative-ui",
    "design-system",
    "json-schema",
    "validation",
    "ai",
    "typescript"
  ],
  "author": "Masoud Soroush <masoud@soroush.tech>",
  "license": "MIT",
  "homepage": "https://docs.soroush.tech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soroush-tech/design-system.git",
    "directory": "packages/ui-spec"
  },
  "bugs": {
    "url": "https://github.com/soroush-tech/design-system/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "vendor/a2ui/v1_0/LICENSE",
    "vendor/a2ui/v1_0/SOURCE.md"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.mjs"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@soroush.tech/eslint-config": "workspace:*",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "oxlint": "^1.78.0",
    "tsdown": "^0.22.14",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  }
}
