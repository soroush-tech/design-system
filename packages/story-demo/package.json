{
  "name": "@soroush.tech/story-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Renders CSF3 Storybook stories as interactive docs demos - live controls, editable code, TS/JS toggle, and CodeSandbox export.",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*/index.ts"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@storybook/react-vite": "^10.6.3",
    "lz-string": "^1.5.0",
    "react-live": "^5.0.1",
    "storybook": "^10.6.3",
    "sucrase": "^3.35.1"
  },
  "peerDependencies": {
    "@soroush.tech/design-system": "workspace:^",
    "@soroush.tech/hooks": "workspace:^",
    "@soroush.tech/markdown": "workspace:^",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@soroush.tech/design-system": "workspace:*",
    "@soroush.tech/eslint-config": "workspace:*",
    "@soroush.tech/hooks": "workspace:*",
    "@soroush.tech/markdown": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.89.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  }
}
