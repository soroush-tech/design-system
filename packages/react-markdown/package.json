{
  "name": "@gild-ui/react-markdown",
  "version": "0.1.0",
  "description": "A markdown editor and renderer for @gild-ui/react - Control, Toolbar, Editor, Preview, LiveEdit, CodeBlock and a themed, zoomable diagram viewer.",
  "keywords": [
    "markdown",
    "editor",
    "renderer",
    "react",
    "design-system",
    "remark",
    "rehype",
    "typescript"
  ],
  "author": "Masoud Soroush <masoud@soroush.tech>",
  "license": "MIT",
  "homepage": "https://gild-ui.soroush.design/react/markdown/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soroush-tech/gild-ui.git",
    "directory": "packages/react-markdown"
  },
  "bugs": {
    "url": "https://github.com/soroush-tech/gild-ui/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./CodeBlock": "./src/CodeBlock/index.ts",
    "./Control": "./src/Control/index.ts",
    "./Editor": "./src/Editor/index.ts",
    "./LiveEdit": "./src/LiveEdit/index.ts",
    "./Mermaid": "./src/Mermaid/index.ts",
    "./Preview": "./src/Preview/index.ts",
    "./Toolbar": "./src/Toolbar/index.ts"
  },
  "types": "./src/index.ts",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.mjs"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./CodeBlock": {
        "import": {
          "types": "./dist/CodeBlock.d.mts",
          "default": "./dist/CodeBlock.mjs"
        },
        "require": {
          "types": "./dist/CodeBlock.d.cts",
          "default": "./dist/CodeBlock.cjs"
        }
      },
      "./Control": {
        "import": {
          "types": "./dist/Control.d.mts",
          "default": "./dist/Control.mjs"
        },
        "require": {
          "types": "./dist/Control.d.cts",
          "default": "./dist/Control.cjs"
        }
      },
      "./Editor": {
        "import": {
          "types": "./dist/Editor.d.mts",
          "default": "./dist/Editor.mjs"
        },
        "require": {
          "types": "./dist/Editor.d.cts",
          "default": "./dist/Editor.cjs"
        }
      },
      "./LiveEdit": {
        "import": {
          "types": "./dist/LiveEdit.d.mts",
          "default": "./dist/LiveEdit.mjs"
        },
        "require": {
          "types": "./dist/LiveEdit.d.cts",
          "default": "./dist/LiveEdit.cjs"
        }
      },
      "./Mermaid": {
        "import": {
          "types": "./dist/Mermaid.d.mts",
          "default": "./dist/Mermaid.mjs"
        },
        "require": {
          "types": "./dist/Mermaid.d.cts",
          "default": "./dist/Mermaid.cjs"
        }
      },
      "./Preview": {
        "import": {
          "types": "./dist/Preview.d.mts",
          "default": "./dist/Preview.mjs"
        },
        "require": {
          "types": "./dist/Preview.d.cts",
          "default": "./dist/Preview.cjs"
        }
      },
      "./Toolbar": {
        "import": {
          "types": "./dist/Toolbar.d.mts",
          "default": "./dist/Toolbar.mjs"
        },
        "require": {
          "types": "./dist/Toolbar.d.cts",
          "default": "./dist/Toolbar.cjs"
        }
      }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "typesVersions": {
      "*": {
        "*": [
          "./dist/*.d.cts"
        ]
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:types": "pnpm build && tsc -p type-tests/tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@gild-ui/core": "workspace:^",
    "@gild-ui/hooks": "workspace:^",
    "mermaid": "^12.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5"
  },
  "peerDependencies": {
    "@gild-ui/react": "workspace:^",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@gild-ui/react": "workspace:*",
    "@soroush.tech/eslint-config": "workspace:*",
    "@storybook/react-vite": "^10.6.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.93.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.7",
    "tsdown": "^0.23.7",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  }
}
