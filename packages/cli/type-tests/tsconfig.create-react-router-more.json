{
  // The React Router app create writes, under the app's own tsconfig.json: create-react-router-more/ is the
  // starter's output, kept in sync by src/create/react-router/react-router.test.ts. It reads the
  // design system's built types next to this package, as an app reads the published ones, and the
  // rest from this package's devDependencies, which are the versions the starter installs.
  "extends": "./create-react-router-more/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@soroush.design/react": ["../../react/dist/index.d.mts"],
      "@soroush.design/react/*": ["../../react/dist/*.d.mts"],
      "@soroush.design/react-components": ["../../react-components/dist/index.d.mts"],
      "@soroush.design/react-components/*": ["../../react-components/dist/*.d.mts"],
      "@soroush.design/react-theme": ["../../react-theme/dist/index.d.mts"],
      "@soroush.design/react-theme/*": ["../../react-theme/dist/*.d.mts"]
    }
  }
}
