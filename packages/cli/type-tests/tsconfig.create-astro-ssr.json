{
  // The TypeScript of the Astro app create writes, under the app's own tsconfig.json: create-astro-ssr/ is
  // the starter's output, kept in sync by src/create/astro/astro.test.ts. Its .astro files are
  // checked by `astro check` in the smoke test, which installs the app. It reads the design
  // system's built types next to this package, as an app reads the published ones.
  "extends": "./create-astro-ssr/tsconfig.json",
  "include": ["./create-astro-ssr/src/**/*.ts", "./create-astro-ssr/src/**/*.tsx"],
  "compilerOptions": {
    "paths": {
      "@soroush.tech/design-system": ["../../design-system/dist/index.d.mts"],
      "@soroush.tech/design-system/*": ["../../design-system/dist/*.d.mts"]
    }
  }
}
