---
import { ClientRouter } from 'astro:transitions'
import Header from '../components/Header'
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My App</title>
    <ClientRouter />
  </head>
  <body>
    <Header client:load transition:persist />
    <main>
      <slot />
    </main>
    <script>
      // Astro's client router replaces the head on each move between pages, and with it the style
      // elements of the styling engine: the one its cache writes its rules into (`data-style`),
      // the ones it adopted from the server (`data-umber`, and React's own, `data-precedence`),
      // and its two markers (a `<meta>` named `...-options` and one named `...-global`). They must
      // stay the very elements the cache holds, or it writes into one the page no longer has, so
      // each gets an id the router keeps. The next page's own styles, which its HTML holds next to
      // each island, move into its head, where the cache reads each element as it arrives and the
      // islands expect them as they hydrate - but not its base styles (the global rules and the
      // root theme): the header, which the router keeps, draws those in the scheme picked.
      const engineElements =
        'style[data-style], style[data-umber], style[data-precedence], meta[name$="-global"], meta[name$="-options"]'
      const nameAttributes = ['data-umber', 'data-href', 'data-style', 'name']
      document.addEventListener('astro:before-swap', ({ newDocument }) => {
        const kept = new Set()
        document.head.querySelectorAll(engineElements).forEach((element, index) => {
          const id = `soroush-styles-${index}`
          element.setAttribute('data-astro-transition-persist', id)
          const placeholder = newDocument.createElement(element.localName)
          placeholder.setAttribute('data-astro-transition-persist', id)
          newDocument.head.append(placeholder)
          const name =
            nameAttributes.map((attribute) => element.getAttribute(attribute)).find(Boolean) ?? ''
          kept.add(name)
        })
        newDocument.body.querySelectorAll(engineElements).forEach((element) => {
          const name =
            nameAttributes.map((attribute) => element.getAttribute(attribute)).find(Boolean) ?? ''
          const isBase = name.split(' ').some((part) => part.includes('-global'))
          if (kept.has(name) || isBase) element.remove()
          else newDocument.head.append(element)
        })
      })
    </script>
  </body>
</html>
