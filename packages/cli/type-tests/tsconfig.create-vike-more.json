{
  // The Vike app create writes with more libraries, under the app's own tsconfig.json: create-vike-more/ is the starter's
  // output, kept in sync by src/create/vike/vike.test.ts. It reads the design system's built types
  // next to this package, as an app reads the published ones, and the rest from this package's
  // devDependencies, which are the versions the starter installs.
  "extends": "./create-vike-more/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@soroush.design/react": ["../../react/dist/index.d.mts"],
      "@soroush.design/react/*": ["../../react/dist/*.d.mts"],
      "@soroush.design/core/*": ["../../core/dist/*.d.mts"],
      "@soroush.design/react-hooks/*": ["../../react-hooks/dist/*.d.mts"]
    }
  }
}
