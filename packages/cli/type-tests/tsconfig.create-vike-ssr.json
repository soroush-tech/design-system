{
  // The SSR Vike app create writes, under the app's own tsconfig.json: create-vike-ssr/ is the
  // starter's output, kept in sync by src/create/vike/vike.test.ts. It reads the design system's
  // built types next to this package, as an app reads the published ones.
  "extends": "./create-vike-ssr/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@soroush.tech/design-system": ["../../react-components/dist/index.d.mts"],
      "@soroush.tech/design-system/*": ["../../react-components/dist/*.d.mts"]
    }
  }
}
