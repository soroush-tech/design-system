{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "printWidth": 100,
  "endOfLine": "lf",
  "sortPackageJson": false,
  "ignorePatterns": [
    "packages/ui-spec/vendor",
    "packages/core/src/catalog/themeComponents.ts",
    "packages/cli/templates/*/js/**",
    "packages/cli/templates/**/README.md"
  ]
}
